; LAD GEM flags and parameters

; flags
lgem_commonmode_flag = 2; 0: cm_sorting, 1: cm_danning, 2: cm_histo
lgem_zerosuppress = 1 ; 1: do zero supress ofline, remove Strips where the ADCsum if below nsigm*pedrms
lgem_zerosuppress_nsigma = 5.0
lgem_onlinezerosuppress = 0 ; 1: zero supress is being done online
lgem_pedsub_online = 0 ; 1: Ped Subtraction is being done at the MPD's
lgem_max2Dhits = 10000000 ;changed
lgem_max_tracks = 150000 ;
lgem_zerosuppress_TS = 0; Remove time samples where the common mode and pedestal sutracted ADC values are below a certain threshold

; place holder for flags, parameters
lgem_pedestal_mode = 0 ; 1: do GEM ped and CM calculation, should be off for production run 
;lgem_do_neg_signal_study = 0
;lgem_commonmode_online_flag = 3
lgem_commonmode_nstriphi = 20
lgem_commonmode_nstriplo = 20
lgem_commonmode_niter = 3
lgem_commonmode_range_nsigma = 5.0
lgem_commonmode_minstrips = 20

;lgem_trigtime_slope = 1.0
;lgem_sample_period = 24.0
;lgem_sigmahitshape = 0.0004

lgem_usestriptimingcut = 1
;lgem_useTSchi2cut = 0
lgem_suppressfirstlast = 1

lgem_clustering_flag = 0

; Offline threshold
lgem_threshold_sample = 100.0
lgem_threshold_stripsum = 400.
lgem_threshold_clustersum = 800.

lgem_min_strip_per_clust = 2 ; (was 2)
lgem_max_strip_per_clust = -1
lgem_min_time_samp = 0
lgem_max_time_samp= 6

lgem_adcasym_cut = 0.7
lgem_adcasym_sigma = 0.06
lgem_delta_cut = 25.0

lgem_peakprominence_minsigma = 3.0
lgem_peakprominence_minfraction = 0.15

lgem_maxnu_charge = 4
lgem_maxnv_charge = 4
lgem_maxnu_pos = 3
lgem_maxnv_pos = 3


;GEM timing cut 
lgem_m0_maxstrip_t0 = 80.0, 80.0
lgem_m0_maxstrip_t0_deconv = 50.0, 50.0
lgem_m0_maxstrip_t0_fit = 20.0, 20.0
lgem_m0_maxstrip_tcut = 6.5, 6.5
lgem_m0_maxstrip_tcut_deconv = 4.5, 4.5
lgem_m0_maxstrip_tcut_fit = 4.5, 4.5
lgem_m0_maxstrip_tsigma = 10.0, 10.0
lgem_m0_maxstrip_tsigma_deconv = 15.0, 15.0
lgem_m0_maxstrip_tsigma_fit = 10.0, 10.0
lgem_m0_HitTimeMean = 80.0, 80.0
lgem_m0_HitTimeMeanDeconv = 50.0, 50.0
lgem_m0_HitTimeMeanFit = 20.0, 20.0
lgem_m0_HitTimeSigma = 10.0, 10.0
lgem_m0_HitTimeSigmaDeconv = 15.0, 15.0
lgem_m0_HitTimeSigmaFit = 10.0, 10.0

lgem_m1_maxstrip_t0 = 80.0, 80.0
lgem_m1_maxstrip_t0_deconv = 50.0, 50.0
lgem_m1_maxstrip_t0_fit = 20.0, 20.0
lgem_m1_maxstrip_tcut = 6.5, 6.5
lgem_m1_maxstrip_tcut_deconv = 4.5, 4.5
lgem_m1_maxstrip_tcut_fit = 4.5, 4.5
lgem_m1_maxstrip_tsigma = 10.0, 10.0
lgem_m1_maxstrip_tsigma_deconv = 15.0, 15.0
lgem_m1_maxstrip_tsigma_fit = 10.0, 10.0
lgem_m1_HitTimeMean = 80.0, 80.0
lgem_m1_HitTimeMeanDeconv = 50.0, 50.0
lgem_m1_HitTimeMeanFit = 20.0, 20.0
